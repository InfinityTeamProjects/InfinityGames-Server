{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "../UserService.API/Logs/UserApiLog.log",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {CorrelationId} {Username} {Message:lj}{NewLine}{Exception}",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 4194304,
          "retainedFileCountLimit": 10,
          "rollingInterval": "Minute"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Username=YourUsername;Password=YourPassword;Database=InfinityGames-UserDB;",
    "LocalConnection": "Host=localhost;Port=5432;Username=YourUsername;Password=YourPassword;Database=InfinityGames-LocalUserDB;"
  },
  "Redis": {
    "ConnectionString": "127.0.0.1:6379, abortConnect=false",
    "ExpirationMinutes": 1
  },
  "JWTConfiguration": {
    "ValidAudience": "https://localhost:7250/",
    "ValidIssuer": "https://localhost:7250/",
    "Secret": "SecretKey",
    "ExpireDays": 1
  },
  "EmailSettings": {
    "SmtpHost": "smtp.gmail.com",
    "SmtpPort": "587",
    "SmtpUser": "Your email",
    "UserName": "Infinity Games",
    "SmtpPass": "Your SMPT Password",
    "FromEmail": "Your email"
  },
  "AdminSettings": {
    "Name": "Name",
    "Surname": "Surname",
    "Username": "Username",
    "Password": "Take a pass",
    "Email": "email"
  },
  "Roles": [ "Admin", "User" ]
}